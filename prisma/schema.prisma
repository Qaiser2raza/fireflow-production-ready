generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model approval_logs {
  id                                              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id                                   String            @db.Uuid
  action_type                                     String            @db.VarChar(50)
  target_entity_type                              String            @db.VarChar(50)
  target_entity_id                                String            @db.Uuid
  requested_by_user_id                            String            @db.Uuid
  approved_by_user_id                             String            @db.Uuid
  approved_by_session_id                          String?           @db.Uuid
  reason                                          String?
  created_at                                      DateTime          @default(now()) @db.Timestamp(6)
  order_id                                        String?           @db.Uuid
  cashier_sessions                                cashier_sessions? @relation(fields: [approved_by_session_id], references: [id])
  staff_approval_logs_approved_by_user_idTostaff  staff             @relation("approval_logs_approved_by_user_idTostaff", fields: [approved_by_user_id], references: [id])
  orders                                          orders?           @relation(fields: [order_id], references: [id], onUpdate: NoAction)
  staff_approval_logs_requested_by_user_idTostaff staff             @relation("approval_logs_requested_by_user_idTostaff", fields: [requested_by_user_id], references: [id])
  restaurants                                     restaurants       @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([created_at])
  @@index([restaurant_id])
  @@index([target_entity_id])
}

model audit_logs {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id     String?      @db.Uuid
  staff_id          String?      @db.Uuid
  action_type       String       @db.VarChar(50)
  entity_type       String       @db.VarChar(50)
  entity_id         String?      @db.Uuid
  details           Json?
  ip_address        String?      @db.Inet
  created_at        DateTime?    @default(now()) @db.Timestamp(6)
  from_state        String?
  performed_by_role String?
  session_id        String?
  to_state          String?
  restaurants       restaurants? @relation(fields: [restaurant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  staff             staff?       @relation(fields: [staff_id], references: [id], onUpdate: NoAction)
  platform_actor_id String?    @db.Uuid
  support_session_id String?   @db.Uuid
}

model cashier_sessions {
  id                                      String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id                           String               @db.Uuid
  opened_by                               String               @db.Uuid
  closed_by                               String?              @db.Uuid
  opened_at                               DateTime             @default(now()) @db.Timestamp(6)
  closed_at                               DateTime?            @db.Timestamp(6)
  opening_float                           Decimal              @default(0) @db.Decimal(10, 2)
  expected_cash                           Decimal?             @db.Decimal(10, 2)
  actual_cash                             Decimal?             @db.Decimal(10, 2)
  difference                              Decimal?             @db.Decimal(10, 2)
  status                                  String               @default("OPEN") @db.VarChar(20)
  notes                                   String?
  terminal_id                             String?
  approval_logs                           approval_logs[]
  staff_cashier_sessions_closed_byTostaff staff?               @relation("cashier_sessions_closed_byTostaff", fields: [closed_by], references: [id])
  staff_cashier_sessions_opened_byTostaff staff                @relation("cashier_sessions_opened_byTostaff", fields: [opened_by], references: [id])
  restaurants                             restaurants          @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  cashier_shift_logs                      cashier_shift_logs[]
  orders                                  orders[]
}

model cashier_shift_logs {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id    String           @db.Uuid
  session_id       String           @db.Uuid
  type             String           @db.VarChar(20)
  amount           Decimal          @db.Decimal(10, 2)
  description      String
  category         String?          @db.VarChar(50)
  reference_id     String?          @db.VarChar(100)
  status           String           @default("PENDING") @db.VarChar(20)
  processed_by     String?          @db.Uuid
  created_at       DateTime         @default(now()) @db.Timestamp(6)
  staff            staff?           @relation(fields: [processed_by], references: [id])
  restaurants      restaurants      @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  cashier_sessions cashier_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade)
}

model chart_of_accounts {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id           String                @db.Uuid
  code                    String                @db.VarChar(20)
  name                    String                @db.VarChar(100)
  type                    AccountType
  description             String?
  parent_id               String?               @db.Uuid
  is_active               Boolean               @default(true)
  created_at              DateTime              @default(now()) @db.Timestamp(6)
  updated_at              DateTime              @default(now()) @db.Timestamp(6)
  is_system               Boolean               @default(false)
  chart_of_accounts       chart_of_accounts?    @relation("chart_of_accountsTochart_of_accounts", fields: [parent_id], references: [id])
  other_chart_of_accounts chart_of_accounts[]   @relation("chart_of_accountsTochart_of_accounts")
  restaurants             restaurants           @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  journal_entry_lines     journal_entry_lines[]

  @@unique([restaurant_id, code])
}

model customer_addresses {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id  String    @db.Uuid
  label        String    @db.VarChar(50)
  full_address String
  landmarks    String?
  is_default   Boolean   @default(false)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  customers    customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
}

model customer_ledgers {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id      String                  @db.Uuid
  customer_id        String                  @db.Uuid
  order_id           String?                 @db.Uuid
  entry_type         CustomerLedgerEntryType
  amount             Decimal                 @db.Decimal(10, 2)
  balance_after      Decimal                 @db.Decimal(10, 2)
  description        String?
  processed_by       String?
  created_at         DateTime                @default(now()) @db.Timestamp(6)
  entry_status       String                  @default("provisional")
  reviewed_at        DateTime?
  reviewed_by        String?
  flag_reason        String?
  flagged_for_review Boolean                 @default(false)
  customers          customers               @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  orders             orders?                 @relation(fields: [order_id], references: [id])
  restaurants        restaurants             @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@index([restaurant_id])
}

model customers {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id      String               @db.Uuid
  name               String?              @db.VarChar(100)
  phone              String               @db.VarChar(20)
  address            String?
  notes              String?
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @default(now()) @db.Timestamp(6)
  credit_limit       Decimal              @default(0) @db.Decimal(10, 2)
  credit_enabled     Boolean              @default(false)
  customer_addresses customer_addresses[]
  customer_ledgers   customer_ledgers[]
  restaurants        restaurants          @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  delivery_orders    delivery_orders[]
  orders             orders[]
  takeaway_orders    takeaway_orders[]

  @@unique([restaurant_id, phone])
}

model delivery_orders {
  id                        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id                  String     @unique @db.Uuid
  customer_name             String?
  customer_phone            String
  delivery_address          String?
  driver_id                 String?    @db.Uuid
  dispatched_at             DateTime?
  customer_id               String?    @db.Uuid
  current_lat               Decimal?   @db.Decimal(10, 8)
  current_lng               Decimal?   @db.Decimal(11, 8)
  delivered_at              DateTime?
  delivery_duration_minutes Int?
  failed_reason             String?
  last_location_update      DateTime?
  customers                 customers? @relation(fields: [customer_id], references: [id])
  staff                     staff?     @relation(fields: [driver_id], references: [id])
  orders                    orders     @relation(fields: [order_id], references: [id])
}

model dine_in_orders {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id            String   @unique @db.Uuid
  table_id            String   @db.Uuid
  guest_count         Int
  waiter_id           String?  @db.Uuid
  seated_at           DateTime @default(now())
  guest_count_history Json?
  orders              orders   @relation(fields: [order_id], references: [id])
  tables              tables   @relation(fields: [table_id], references: [id])
  staff               staff?   @relation(fields: [waiter_id], references: [id])
}

model expenses {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id String          @db.Uuid
  description   String
  amount        Decimal         @db.Decimal(10, 2)
  created_at    DateTime        @default(now()) @db.Timestamp(6)
  processed_by  String?         @db.Uuid
  reference_id  String?         @db.VarChar(100)
  category      ExpenseCategory @default(MISCELLANEOUS)
  staff         staff?          @relation(fields: [processed_by], references: [id])
  restaurants   restaurants     @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([created_at])
  @@index([restaurant_id])
}

model fbr_sync_logs {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id    String      @db.Uuid
  order_id         String?     @db.Uuid
  request_payload  Json
  response_payload Json?
  status           String
  error_message    String?
  created_at       DateTime    @default(now())
  restaurants      restaurants @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
}

model fire_batches {
  id                                           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id                                     String         @db.Uuid
  version_number                               Int            @default(1)
  recalled_from_batch_id                       String?        @db.Uuid
  created_by_user_id                           String         @db.Uuid
  recalled_at                                  DateTime?
  recalled_by                                  String?        @db.Uuid
  metadata_json                                Json?
  created_at                                   DateTime       @default(now()) @db.Timestamp(6)
  staff_fire_batches_created_by_user_idTostaff staff          @relation("fire_batches_created_by_user_idTostaff", fields: [created_by_user_id], references: [id])
  orders                                       orders         @relation(fields: [order_id], references: [id], onDelete: Cascade)
  staff_fire_batches_recalled_byTostaff        staff?         @relation("fire_batches_recalled_byTostaff", fields: [recalled_by], references: [id])
  fire_batches                                 fire_batches?  @relation("fire_batchesTofire_batches", fields: [recalled_from_batch_id], references: [id])
  other_fire_batches                           fire_batches[] @relation("fire_batchesTofire_batches")
  order_items                                  order_items[]

  @@index([created_at])
  @@index([order_id])
}

model installation_logs {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  installer_id String?   @db.Uuid
  device_id    String?   @db.VarChar(100)
  status       String    @db.VarChar(50)
  notes        String?
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  staff        staff?    @relation(fields: [installer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model inventory_items {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id        String                 @db.Uuid
  name                 String                 @db.VarChar(100)
  unit_of_measure      String                 @db.VarChar(20)
  current_stock        Decimal                @default(0) @db.Decimal(10, 4)
  minimum_stock        Decimal                @default(0) @db.Decimal(10, 4)
  unit_cost            Decimal                @default(0) @db.Decimal(10, 4)
  category             String?                @db.VarChar(50)
  created_at           DateTime               @default(now())
  updated_at           DateTime               @default(now())
  restaurants          restaurants            @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  purchase_order_items purchase_order_items[]
  recipe_items         recipe_items[]
}

model journal_entries {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id       String                @db.Uuid
  reference_type      String                @db.VarChar(50)
  reference_id        String?
  date                DateTime              @db.Timestamp(6)
  description         String?
  processed_by        String?
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  restaurants         restaurants           @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  journal_entry_lines journal_entry_lines[]
}

model journal_entry_lines {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journal_entry_id  String            @db.Uuid
  account_id        String            @db.Uuid
  description       String?
  debit             Decimal           @default(0) @db.Decimal(15, 4)
  credit            Decimal           @default(0) @db.Decimal(15, 4)
  meta              Json?
  reference_id      String            @db.VarChar(100)
  reference_type    String            @db.VarChar(50)
  chart_of_accounts chart_of_accounts @relation(fields: [account_id], references: [id])
  journal_entries   journal_entries   @relation(fields: [journal_entry_id], references: [id], onDelete: Cascade)
}

model ledger_entries {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id    String      @db.Uuid
  account_id       String?     @db.Uuid
  transaction_type String      @db.VarChar(10)
  amount           Decimal     @db.Decimal(10, 2)
  reference_type   String      @db.VarChar(50)
  reference_id     String?
  description      String?
  processed_by     String?
  created_at       DateTime    @default(now()) @db.Timestamp(6)
  restaurants      restaurants @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
}

model license_keys {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id   String?      @db.Uuid
  license_key     String       @unique
  is_active       Boolean?     @default(false)
  activated_at    DateTime?    @db.Timestamp(6)
  expires_at      DateTime?    @db.Timestamp(6)
  license_type    String?      @default("STANDARD") @db.VarChar(50)
  device_limit    Int?         @default(1)
  last_checked_at DateTime?    @db.Timestamp(6)
  created_at      DateTime     @default(now())
  restaurants     restaurants? @relation(fields: [restaurant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model menu_categories {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id String       @db.Uuid
  name          String       @db.VarChar(50)
  name_urdu     String?      @db.VarChar(50)
  priority      Int          @default(0)
  created_at    DateTime     @default(now())
  restaurants   restaurants  @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  menu_items    menu_items[]

  @@unique([restaurant_id, name])
}

model menu_item_variants {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menu_item_id String        @db.Uuid
  name         String        @db.VarChar(50)
  name_urdu    String?       @db.VarChar(50)
  price        Decimal       @db.Decimal(10, 2)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @default(now())
  menu_items   menu_items    @relation(fields: [menu_item_id], references: [id], onDelete: Cascade)
  order_items  order_items[]
}

model menu_items {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id      String?              @db.Uuid
  name               String               @db.VarChar(100)
  name_urdu          String?              @db.VarChar(100)
  description        String?
  price              Decimal              @db.Decimal(10, 2)
  category           String               @db.VarChar(50)
  image_url          String?
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  is_available       Boolean?             @default(true)
  station            String?              @default("KITCHEN") @db.VarChar(20)
  track_stock        Boolean?             @default(false)
  daily_stock        Int?                 @default(0)
  cost_price         Decimal?             @db.Decimal(10, 2)
  category_id        String?              @db.Uuid
  requires_prep      Boolean              @default(true)
  station_id         String?              @db.Uuid
  menu_item_variants menu_item_variants[]
  menu_categories    menu_categories?     @relation(fields: [category_id], references: [id])
  restaurants        restaurants?         @relation(fields: [restaurant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stations           stations?            @relation(fields: [station_id], references: [id])
  order_items        order_items[]
  recipe_items       recipe_items[]
}

model order_intelligence {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id                String    @unique @db.Uuid
  predicted_complete_time DateTime?
  bottleneck_detected     Boolean   @default(false) @map(" bottleneck_detected")
  force_settled_at        DateTime?
  force_settled_by        String?   @db.Uuid
  created_at              DateTime  @default(now())
  updated_at              DateTime  @default(now())
  orders                  orders    @relation(fields: [order_id], references: [id], onDelete: Cascade)
}

model order_items {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id             String              @db.Uuid
  menu_item_id         String              @db.Uuid
  quantity             Int
  unit_price           Decimal             @db.Decimal(10, 2)
  total_price          Decimal             @db.Decimal(10, 2)
  station              String?
  started_at           DateTime?
  completed_at         DateTime?
  served_at            DateTime?
  special_instructions String?
  modifications        Json?
  item_name            String?
  category             String?
  created_at           DateTime            @default(now())
  unit_cost            Decimal?            @db.Decimal(10, 2)
  predicted_ready_time DateTime?
  force_ready_at       DateTime?
  force_ready_by       String?             @db.Uuid
  item_status          ItemStatus?         @default(PENDING)
  station_id           String?             @db.Uuid
  variant_id           String?             @db.Uuid
  fire_batch_id        String?             @db.Uuid
  fired_at             DateTime?           @db.Timestamp(6)
  skip_reason          SkipReason?
  status_updated_at    DateTime?           @db.Timestamp(6)
  status_updated_by    String?
  fire_batches         fire_batches?       @relation(fields: [fire_batch_id], references: [id])
  menu_items           menu_items          @relation(fields: [menu_item_id], references: [id])
  orders               orders              @relation(fields: [order_id], references: [id])
  stations             stations?           @relation(fields: [station_id], references: [id])
  menu_item_variants   menu_item_variants? @relation(fields: [variant_id], references: [id])
}

model order_type_defaults {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id String      @db.Uuid
  order_type    OrderType
  tax_enabled   Boolean     @default(true)
  tax_rate      Decimal     @default(16) @db.Decimal(5, 2)
  tax_type      TaxType     @default(INCLUSIVE)
  svc_enabled   Boolean     @default(false)
  svc_rate      Decimal     @default(6) @db.Decimal(5, 2)
  delivery_fee  Decimal     @default(0) @db.Decimal(10, 2)
  discount_max  Decimal     @default(0) @db.Decimal(5, 2)
  created_at    DateTime    @default(now()) @db.Timestamp(6)
  updated_at    DateTime    @default(now()) @db.Timestamp(6)
  restaurants   restaurants @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@unique([restaurant_id, order_type])
}

model orders {
  id                                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id                          String              @db.Uuid
  total                                  Decimal             @default(0) @db.Decimal(10, 2)
  items                                  Json?
  table_id                               String?             @db.Uuid
  guest_count                            Int?
  customer_name                          String?
  customer_phone                         String?
  delivery_address                       String?
  assigned_waiter_id                     String?             @db.Uuid
  assigned_driver_id                     String?             @db.Uuid
  created_at                             DateTime            @default(now())
  updated_at                             DateTime            @default(now())
  service_charge                         Decimal?            @default(0) @db.Decimal(10, 2)
  delivery_fee                           Decimal?            @default(0) @db.Decimal(10, 2)
  tax                                    Decimal?            @default(0) @db.Decimal(10, 2)
  discount                               Decimal?            @default(0) @db.Decimal(10, 2)
  breakdown                              Json?
  cancelled_at                           DateTime?
  cancelled_by                           String?
  cancellation_reason                    String?
  cancellation_notes                     String?
  voided_at                              DateTime?
  voided_by                              String?
  void_reason                            String?
  void_notes                             String?
  refund_transaction_id                  String?
  is_proforma_printed                    Boolean             @default(false)
  payment_status                         PaymentStatus?      @default(UNPAID)
  predicted_complete_time                DateTime?
  bottleneck_detected                    Boolean             @default(false)
  force_settled_at                       DateTime?
  force_settled_by                       String?             @db.Uuid
  status                                 OrderStatus?        @default(ACTIVE)
  type                                   OrderType
  rider_shift_id                         String?             @db.Uuid
  closed_at                              DateTime?
  completed_at                           DateTime?
  customer_id                            String?             @db.Uuid
  fbr_invoice_number                     String?
  fbr_qr_code                            String?
  fbr_response                           String?
  fbr_sync_status                        String              @default("PENDING")
  last_action_at                         DateTime?           @default(now())
  last_action_by                         String?
  last_action_desc                       String?
  order_number                           String?             @unique @db.VarChar(20)
  sync_status                            String              @default("PENDING")
  session_id                             String?             @db.Uuid
  tax_exempt                             Boolean             @default(false)
  tax_type                               TaxType             @default(INCLUSIVE)
  deleted_at                             DateTime?
  deleted_by                             String?
  deleted_reason                         String?
  is_deleted                             Boolean             @default(false)
  fbr_synced_at                          DateTime?
  approval_logs                          approval_logs[]
  customer_ledgers                       customer_ledgers[]
  delivery_orders                        delivery_orders?
  dine_in_orders                         dine_in_orders?
  fire_batches                           fire_batches[]
  order_intelligence                     order_intelligence?
  order_items                            order_items[]
  staff_orders_assigned_driver_idTostaff staff?              @relation("orders_assigned_driver_idTostaff", fields: [assigned_driver_id], references: [id])
  staff_orders_assigned_waiter_idTostaff staff?              @relation("orders_assigned_waiter_idTostaff", fields: [assigned_waiter_id], references: [id])
  customers                              customers?          @relation(fields: [customer_id], references: [id])
  restaurants                            restaurants         @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  rider_shifts                           rider_shifts?       @relation(fields: [rider_shift_id], references: [id])
  cashier_sessions                       cashier_sessions?   @relation(fields: [session_id], references: [id])
  tables                                 tables?             @relation(fields: [table_id], references: [id])
  reservation_orders                     reservation_orders?
  takeaway_orders                        takeaway_orders?
  transactions                           transactions[]
  payments                               payments[]
  fiscal_documents                       fiscal_documents[]

  @@index([assigned_driver_id])
  @@index([assigned_waiter_id])
  @@index([restaurant_id])
  @@index([table_id])
}

model pairing_codes {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id          String               @db.Uuid
  pairing_code           String               @db.VarChar(10)
  created_at             DateTime             @default(now()) @db.Timestamp(6)
